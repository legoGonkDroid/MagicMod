[General]
ConfigVersion=1.3
InstanceType=OneSix
name=MagicMod
iconKey=default
AutomaticJava=true
OverrideMemory=true
MinMemAlloc=512
MaxMemAlloc=8192
OverrideCommands=true
PreLaunchCommand="$INST_JAVA" -jar packwiz-installer-bootstrap.jar https://raw.githubusercontent.com/jarroyer/MagicMod/pack/pack.toml
